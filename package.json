{
  "name": "ghostlink",
  "version": "0.1.0",
  "description": "Multi-agent legacy code modernization tool — Kiroween 2026 Frankenstein entry",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "nodemon --exec tsx src/api/server.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "keywords": [
    "legacy-code",
    "code-modernization",
    "multi-agent",
    "kiro",
    "kiroween",
    "frankenstein",
    "ai",
    "property-based-testing"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "*",
    "@modelcontextprotocol/sdk": "*",
    "archiver": "*",
    "cors": "*",
    "eventsource": "*",
    "express": "*",
    "helmet": "*",
    "multer": "*",
    "uuid": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@tailwindcss/forms": "*",
    "@types/archiver": "*",
    "@types/cors": "*",
    "@types/eventsource": "*",
    "@types/express": "*",
    "@types/multer": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/react-router-dom": "*",
    "@types/uuid": "*",
    "@vitejs/plugin-react": "*",
    "autoprefixer": "*",
    "concurrently": "*",
    "fast-check": "*",
    "highlight.js": "*",
    "nodemon": "*",
    "postcss": "*",
    "react": "*",
    "react-dom": "*",
    "react-router-dom": "*",
    "tailwindcss": "*",
    "tree-sitter": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
